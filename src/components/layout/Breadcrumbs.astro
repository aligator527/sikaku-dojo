---
import { ChevronRight } from '@lucide/astro';

import { breadcrumbLd } from '../../lib/seo/structured-data';

interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
// The same trail as schema.org BreadcrumbList; the last crumb is the current page.
const trail = breadcrumbLd(
  items.map((item, i) => ({
    label: item.label,
    url: new URL(
      i === items.length - 1 || !item.href ? Astro.url.pathname : item.href,
      Astro.site,
    ).toString(),
  })),
);
---

<script type="application/ld+json" set:html={JSON.stringify(trail).replace(/</g, '\\u003c')} />
<nav class="crumbs" aria-label="パンくずリスト" data-pagefind-ignore>
  <ol>
    {items.map((item, i) => (
      <li>
        {i > 0 && <ChevronRight size={13} aria-hidden="true" />}
        {item.href && i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1);
    padding: 0;
    list-style: none;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  a {
    color: var(--ink-2);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
