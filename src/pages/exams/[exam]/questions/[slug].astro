---
import { ArrowLeft, ArrowRight, List } from '@lucide/astro';
import { getCollection } from 'astro:content';

import { Explanation, QuestionBody, QuestionMeta } from '../../../../components/question/feedback';
import QuestionPage from '../../../../components/question/QuestionPage';
import q from '../../../../components/question/Question.module.css';
import { t } from '../../../../i18n';
import ExamLayout from '../../../../layouts/ExamLayout.astro';
import {
  examContext,
  getExams,
  getMentionIndex,
  getQuestions,
  topicName,
  type Exam,
  type QuestionTerm,
} from '../../../../lib/content';
import { answerOnly, type Question } from '../../../../domain/question';
import { excerpt } from '../../../../lib/markdown/excerpt';
import { routes } from '../../../../lib/paths';
import { questionLd } from '../../../../lib/seo/structured-data';

export async function getStaticPaths() {
  // getStaticPaths runs in isolation: constants must live inside it.
  const MAX_TERMS = 10;
  const paths = [];
  const { byQuestion } = await getMentionIndex();
  for (const exam of await getExams()) {
    const questions = await getQuestions(exam.id);
    const stems = new Map(
      (await getCollection('questions', (e) => e.data.exam.id === exam.id)).map((e) => [e.id, e.data.stem]),
    );
    for (const [i, question] of questions.entries()) {
      paths.push({
        params: { exam: exam.id, slug: question.slug },
        props: {
          exam,
          question,
          prev: questions[i - 1],
          next: questions[i + 1],
          summary: excerpt(stems.get(question.id) ?? '', 110),
          terms: (byQuestion.get(question.id) ?? []).slice(0, MAX_TERMS),
        },
      });
    }
  }
  return paths;
}

interface Props {
  exam: Exam;
  question: Question;
  prev?: Question;
  next?: Question;
  summary: string;
  terms: QuestionTerm[];
}

const { exam, question, prev, next, summary, terms } = Astro.props;
const label = t.question.number(question.order);
const mainTopic = topicName(exam, question.topics[0]!).split(/[（(]/)[0];
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ctx = examContext(exam);
// The island needs no topic or section names: those are rendered here.
const islandExam = { ...ctx, topics: {}, sections: {} };
const explanationId = `explanation-${question.slug}`;
// Past papers are searched by their official name (令和6年度 春期 … 午前II 問5).
const pageTitle =
  question.source.kind === 'past' && question.source.label
    ? question.source.label
    : `${exam.name} ${label}（${mainTopic}）`;
const kind = question.source.kind === 'past' ? '過去問題' : '練習問題';
---

<ExamLayout
  exam={exam}
  tab="questions"
  title={pageTitle}
  description={`${exam.name}の${kind}（${mainTopic}）。${summary}（解答と解説つき）`}
  crumb={label}
  searchable
  searchKind="問題"
  ogType="article"
  jsonLd={[questionLd(question, exam, pageUrl, mainTopic ?? '')]}
>
  <div class="question-page">
    <article class={q.question}>
      <header class="head">
        <h1 data-pagefind-meta={`title:${exam.shortName} ${label}`}>
          <span class={q.number}>{label}</span>
          <span class="visually-hidden">{exam.name}</span>
        </h1>
        <QuestionMeta question={question} exam={ctx} topicHref={(id) => routes.topic(exam.id, id)} />
      </header>
      <QuestionBody question={question} />
      <QuestionPage
        client:load
        question={answerOnly(question)}
        exam={islandExam}
        pageUrl={pageUrl}
        explanationId={explanationId}
      />
      <Explanation question={question} choiceStyle={exam.choiceStyle} id={explanationId} />
      {terms.length > 0 && (
        <ul
          class={q.terms}
          aria-label={t.question.terms}
          data-after-answer={terms.every((x) => x.place === 1) ? '' : undefined}
          data-pagefind-ignore
        >
          <li class={q.termsTitle} aria-hidden="true">
            {t.question.terms}
          </li>
          {terms.map(({ term, place }) => (
            <li class={place === 1 ? q.afterAnswer : undefined}>
              <a class="tag tag--link" href={routes.term(term.id)}>
                {term.term}
              </a>
            </li>
          ))}
        </ul>
      )}
    </article>
    {question.source.kind === 'past' && (
      <p class="meta notice">
        {t.question.pastNotice}
        {question.source.url && (
          <>
            {' '}
            <a href={question.source.url} target="_blank" rel="noreferrer">
              {t.question.source}：{question.source.label}
            </a>
          </>
        )}
      </p>
    )}
    <nav class="pager" aria-label="問題の移動" data-pagefind-ignore>
      {prev ? (
        <a href={routes.question(exam.id, prev.slug)} rel="prev">
          <ArrowLeft size={16} aria-hidden="true" />
          <span>
            <small>{t.question.prev}</small>
            {t.question.number(prev.order)}
          </span>
        </a>
      ) : (
        <span />
      )}
      <a href={routes.questions(exam.id)} class="to-list">
        <List size={16} aria-hidden="true" />
        {t.question.list}
      </a>
      {next ? (
        <a href={routes.question(exam.id, next.slug)} rel="next" class="next">
          <span>
            <small>{t.question.next}</small>
            {t.question.number(next.order)}
          </span>
          <ArrowRight size={16} aria-hidden="true" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  </div>
</ExamLayout>

<style>
  .question-page {
    max-width: 50rem;
  }

  .head {
    display: grid;
    gap: var(--s-3);
  }

  .head h1 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .notice {
    margin-top: var(--s-4);
    font-size: var(--fs-xs);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule-strong);
  }

  .pager a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    font-weight: 700;
  }

  .pager small {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--ink-3);
  }

  .pager .next {
    justify-self: end;
    text-align: right;
  }

  .to-list {
    font-size: var(--fs-sm);
    font-weight: 500 !important;
    color: var(--ink-2);
  }
</style>
